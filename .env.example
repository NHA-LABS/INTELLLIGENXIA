# Copier ce fichier vers .env.local, puis lancer npm run build après modification.
# Ces paramètres sont publics et intégrés au navigateur. Aucun secret client.

# Microsoft Entra ID > Inscriptions d'applications > Vue d'ensemble
VITE_ENTRA_CLIENT_ID=9e4f1be0-438e-415e-a5db-eebea0a04bc9
VITE_ENTRA_TENANT_ID=467092d2-790b-4de1-9b3e-38b384eb2a21

# URI exactes à déclarer dans Entra > Authentification > Application monopage.
# Laisser vide pour utiliser automatiquement le domaine courant (local ou VPS).
# En production, vous pouvez renseigner : https://votre-domaine/redirect.html
VITE_ENTRA_REDIRECT_URI=
# Retour après déconnexion, par exemple : https://votre-domaine/index.html
VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=

# SharePoint : identifiants du site, des listes et de la bibliothèque documentaire
VITE_SHAREPOINT_SITE_ID=assurancesnsia.sharepoint.com,35765e6b-5df0-4cde-8ef9-47fe5fafb4c3,5eced96b-88c1-4917-8510-a05551d4f426
VITE_SHAREPOINT_ARTICLES_LIST_ID=29a2ac9d-98ff-4731-b8b3-d151e8b7bb00
VITE_SHAREPOINT_VISITS_LIST_ID=45901f50-8e8b-4bd1-92c8-d412ad20d850
VITE_SHAREPOINT_DOCUMENTS_DRIVE_ID=b!a152NfBd3kyO-Uf-X6-0w2vZzl7BiBdJhRCgVVHU9CZfrqr0z_RWRI0zc4xmUX2M

# Copilot Studio : environnement et nom de schéma de l'agent VIRA
VITE_COPILOT_ENVIRONMENT_ID=Default-467092d2-790b-4de1-9b3e-38b384eb2a21
VITE_COPILOT_SCHEMA_NAME=crbca_veillestratgiquensia_bmQ16w
